{
  "name": "typenative",
  "version": "0.4.2",
  "description": "Build native applications using Typescript.",
  "type": "module",
  "bin": {
    "typenative": "bin/cli.js"
  },
  "types": "./index.d.ts",
  "scripts": {
    "prebuild": "node scripts/gen-version.mjs",
    "build": "tsc",
    "prewatch": "node scripts/gen-version.mjs",
    "watch": "tsc --watch",
    "build:native": "node scripts/build-native.mjs",
    "gen:go": "go -C scripts/gostd run .",
    "vendor:go": "node scripts/vendor-go.mjs",
    "check:go-types": "tsc -p conformance/tsconfig.go-check.json",
    "conformance": "node scripts/conformance.mjs",
    "conformance:parallel": "node scripts/conformance-parallel.mjs",
    "bootstrap:check": "node scripts/bootstrap-check.mjs",
    "test": "npm run conformance",
    "release": "npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danisss9/typenative.git"
  },
  "author": "Dani Santos",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/danisss9/typenative/issues"
  },
  "homepage": "https://github.com/danisss9/typenative#readme",
  "devDependencies": {
    "@types/inquirer": "^9.0.10",
    "@types/node": "^24.19.2",
    "rimraf": "^6.1.3"
  },
  "dependencies": {
    "inquirer": "^14.2.3",
    "typescript": "^6.0.3"
  }
}
