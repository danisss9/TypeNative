# typenative.dev on OVH web hosting (Apache 2.4, PHP 8.4 via .ovhconfig)

Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset utf-8

AddType image/svg+xml .svg
AddType text/javascript .js
AddType application/xml .xml

# Apache's own 403/404s are rendered by the front controller as the site's 404 page.
ErrorDocument 403 /index.php
ErrorDocument 404 /index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # http://(www.)typenative.dev -> https://typenative.dev, in one hop.
    # Other hosts (such as OVH's preview address) are left alone.
    RewriteCond %{HTTP_HOST} ^(www\.)?typenative\.dev$ [NC]
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://typenative.dev%{REQUEST_URI} [R=301,L]
    # If the rule above ever loops on OVH, swap its two middle conditions for:
    #   RewriteCond %{SERVER_PORT} ^80$

    # https://www.typenative.dev -> https://typenative.dev
    RewriteCond %{HTTP_HOST} ^www\.typenative\.dev$ [NC]
    RewriteRule ^ https://typenative.dev%{REQUEST_URI} [R=301,L]

    # /index.php -> / (only when the visitor asked for it, not on internal rewrites)
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s/index\.php[\s?]
    RewriteRule ^index\.php$ / [R=301,L]

    # Never serve internals: the PHP app, dotfiles (.ovhconfig), Markdown notes.
    RewriteRule ^app(/|$) - [R=404,L]
    RewriteRule (^|/)\.(?!well-known/) - [R=404,L]
    RewriteRule \.md$ - [R=404,L]

    # Everything that isn't a real file goes to the front controller (which 404s).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always unset X-Powered-By

    # Unversioned files at the root: cache for a day. (Versioned files under
    # /assets/ are cached for a year by assets/.htaccess; HTML is no-cache,
    # set by PHP.)
    <FilesMatch "^(favicon\.ico|favicon\.svg|apple-touch-icon\.png|robots\.txt|sitemap\.xml)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/ld+json application/xml image/svg+xml
</IfModule>
