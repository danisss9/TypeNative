{
  "extends": "../tsconfig.json",
  // The vendored driver and BSON sources are checked upstream by their own
  // toolchain; noCheck keeps them out of the gate while still resolving their
  // imports for main.ts's own check.
  "compilerOptions": {
    "types": ["../../types/typenative.d.ts", "../../types/typenative-go.d.ts", "../../types/typenative-npm.d.ts"],
    "noCheck": true
  },
  "include": ["main.ts"]
}
