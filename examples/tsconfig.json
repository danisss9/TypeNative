{
    "include": ["**/*.ts"],
    // (the React Compiler example's vendored declarations belong to it alone)
    "exclude": ["react-compiler/vendor", "*/.cache"],
    "compilerOptions": {
      "target": "es2025",
      "useDefineForClassFields": false,
      "lib": [],
      "types": ["../types/typenative.d.ts", "../types/typenative-go.d.ts", "../types/typenative-npm.d.ts"],
      "rootDir": ".",
      "strict": true,
      "noImplicitAny": true,
      "allowSyntheticDefaultImports": true,
      // Local imports keep their .ts extension, as `node main.ts` requires
      "allowImportingTsExtensions": true,
      "noEmit": true,
      // types/ is checked on its own (types/tsconfig.json)
      "skipLibCheck": true
    }
}
